@model OrcamentoImpressao
@{
    Layout = null;
    var orcamento = Model.Orcamento;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Orçamento @orcamento.Numero - Impressão</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/impressao.css" asp-append-version="true" />
</head>
<body>
    <main class="container py-4">
        <div class="acoes-impressao d-flex gap-2 mb-4">
            <button type="button" class="btn btn-primary" onclick="window.print()">Imprimir ou salvar em PDF</button>
            <a asp-action="Detalhes" asp-route-id="@orcamento.Id" class="btn btn-outline-secondary">Voltar ao orçamento</a>
        </div>

        <header class="mb-4">
            <h1 class="h2">Orçamento @orcamento.Numero</h1>
            <p class="mb-0">@orcamento.Titulo</p>
            <p class="text-muted mb-0">@orcamento.SituacaoTexto</p>
        </header>

        <section class="dados-parte mb-3" aria-labelledby="titulo-negocio">
            <h2 id="titulo-negocio" class="h5">Negócio</h2>
            @if (Model.Negocio is null)
            {
                <p>Dados do negócio não configurados.</p>
            }
            else
            {
                <partial name="_DadosParte" model="Model.Negocio" />
            }
        </section>

        <section class="dados-parte mb-3" aria-labelledby="titulo-cliente">
            <h2 id="titulo-cliente" class="h5">Cliente</h2>
            <partial name="_DadosParte" model="Model.Cliente" />
        </section>

        <section class="mb-4" aria-label="Datas do orçamento">
            <p class="mb-1"><strong>Emissão:</strong> @orcamento.DataEmissao.ToString("dd/MM/yyyy")</p>
            <p class="mb-0"><strong>Validade:</strong> @(orcamento.Validade?.ToString("dd/MM/yyyy") ?? "Não informada")</p>
        </section>

        <table class="table table-bordered align-middle">
            <colgroup>
                <col class="col-descricao" />
                <col class="col-quantidade" />
                <col class="col-unidade" />
                <col class="col-valor" />
                <col class="col-valor" />
            </colgroup>
            <thead>
                <tr>
                    <th scope="col">Descrição</th>
                    <th scope="col" class="text-end">Quantidade</th>
                    <th scope="col">Unidade</th>
                    <th scope="col" class="text-end">Preço unitário</th>
                    <th scope="col" class="text-end">Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in orcamento.Itens.OrderBy(item => item.Id))
                {
                    <tr>
                        <td>@item.Descricao</td>
                        <td class="text-end valor">@item.Quantidade.ToString("0.###")</td>
                        <td>@item.Unidade</td>
                        <td class="text-end valor">@item.PrecoUnitario.ToString("C")</td>
                        <td class="text-end valor">@item.Subtotal.ToString("C")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr><th scope="row" colspan="4" class="text-end">Total</th><td class="text-end fw-bold valor">@orcamento.Total.ToString("C")</td></tr>
            </tfoot>
        </table>

        @if (!string.IsNullOrWhiteSpace(orcamento.Observacoes))
        {
            <section class="observacoes mt-4" aria-labelledby="titulo-observacoes">
                <h2 id="titulo-observacoes" class="h5">Observações</h2>
                <p>@orcamento.Observacoes</p>
            </section>
        }
    </main>
</body>
</html>

@model ErrorViewModel
@{
    ViewData["Title"] = "Erro";
}

<h1 class="h2 text-danger">Não foi possível concluir a solicitação.</h1>
<p>Tente novamente. Se o problema continuar, informe o identificador abaixo ao responsável pela aplicação.</p>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Identificador:</strong> <code>@Model.RequestId</code>
    </p>
}

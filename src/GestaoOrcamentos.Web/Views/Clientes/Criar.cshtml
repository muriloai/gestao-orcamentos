@model ClienteFormulario
@{
    ViewData["Title"] = "Cadastrar cliente";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1 class="h2 mb-3">Cadastrar cliente</h1>

        <form asp-action="Criar" method="post">
            <partial name="_Campos" model="Model" />
            <button type="submit" class="btn btn-primary">Salvar cliente</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
        </form>
    </div>
</div>

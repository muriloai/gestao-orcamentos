@model ClienteDetalhes
@{
    ViewData["Title"] = Model.Cliente.Nome;
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <h1 class="h2 mb-0">@Model.Cliente.Nome</h1>
    <div>
        <a asp-action="Editar" asp-route-id="@Model.Cliente.Id" class="btn btn-primary">Editar</a>
        <a asp-controller="Orcamentos" asp-action="Criar" asp-route-clienteId="@Model.Cliente.Id" class="btn btn-outline-primary">Novo orçamento</a>
        <a asp-action="Excluir" asp-route-id="@Model.Cliente.Id" class="btn btn-outline-danger">Excluir</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
    </div>
</div>

@if (TempData["Mensagem"] is string mensagem)
{
    <div class="alert alert-success" role="status">@mensagem</div>
}

<h2 class="h5">Contato</h2>
<dl class="row">
    <dt class="col-sm-3">Pessoa de contato</dt>
    <dd class="col-sm-9">@(Model.Cliente.PessoaContato ?? "Não informado")</dd>
    <dt class="col-sm-3">Telefone/WhatsApp</dt>
    <dd class="col-sm-9">@(Model.Cliente.Telefone ?? "Não informado")</dd>
    <dt class="col-sm-3">E-mail</dt>
    <dd class="col-sm-9">@(Model.Cliente.Email ?? "Não informado")</dd>
</dl>

<h2 class="h5">Endereço</h2>
<dl class="row">
    <dt class="col-sm-3">CEP</dt>
    <dd class="col-sm-9">@(Model.Cliente.Cep ?? "Não informado")</dd>
    <dt class="col-sm-3">Logradouro</dt>
    <dd class="col-sm-9">@(Model.Cliente.Logradouro ?? "Não informado")</dd>
    <dt class="col-sm-3">Número</dt>
    <dd class="col-sm-9">@(Model.Cliente.Numero ?? "Não informado")</dd>
    <dt class="col-sm-3">Complemento</dt>
    <dd class="col-sm-9">@(Model.Cliente.Complemento ?? "Não informado")</dd>
    <dt class="col-sm-3">Bairro</dt>
    <dd class="col-sm-9">@(Model.Cliente.Bairro ?? "Não informado")</dd>
    <dt class="col-sm-3">Cidade</dt>
    <dd class="col-sm-9">@(Model.Cliente.Cidade ?? "Não informado")</dd>
    <dt class="col-sm-3">UF</dt>
    <dd class="col-sm-9">@(Model.Cliente.Uf ?? "Não informado")</dd>
</dl>

@if (!string.IsNullOrWhiteSpace(Model.Cliente.Observacoes))
{
    <h2 class="h5">Observações</h2>
    <p style="white-space: pre-wrap">@Model.Cliente.Observacoes</p>
}

<h2 class="h5 mt-4">Orçamentos</h2>
@if (Model.Orcamentos.Count == 0)
{
    <p>Nenhum orçamento para este cliente.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th scope="col">Número</th>
                    <th scope="col">Emissão</th>
                    <th scope="col">Título</th>
                    <th scope="col">Situação</th>
                    <th scope="col" class="text-end">Total</th>
                    <th scope="col">Ação</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var orcamento in Model.Orcamentos)
                {
                    <tr>
                        <td>@orcamento.Numero</td>
                        <td>@orcamento.DataEmissao.ToString("dd/MM/yyyy")</td>
                        <td>@orcamento.Titulo</td>
                        <td>@orcamento.SituacaoTexto</td>
                        <td class="text-end">@orcamento.Total.ToString("C")</td>
                        <td><a asp-controller="Orcamentos" asp-action="Detalhes" asp-route-id="@orcamento.Id">Consultar</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
